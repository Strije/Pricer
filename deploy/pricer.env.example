# /etc/pricer.env — владелец root, права 600. setup.sh заполняет его сам; в git — только этот пример.
PRICER_DATABASE_URL=postgresql+psycopg://pricer:ПАРОЛЬ@127.0.0.1/pricer
PRICER_VAR_DIR=/var/lib/pricer
PRICER_PUBLIC_URL=https://pricer.example.ru
PRICER_SECURE_COOKIES=1
# Регистрация новых организаций с сайта: 0 — только командой «bash setup.sh create-org»
PRICER_ALLOW_SIGNUP=0
# Как часто сервер сам спрашивает статусы заказов у поставщиков, минут (0 — только по кнопке)
PRICER_STATUS_REFRESH_MINUTES=30
# Сторож: сообщения о сбоях в Telegram (можно взять бота из /etc/avtodrug-api.env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API=
